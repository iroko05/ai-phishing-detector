# ============================================================
# AI-Phishing Gateway — пример конфигурации (скопируйте в .env)
#   cp .env.example .env
# Все переменные необязательны: без них шлюз стартует на безопасных
# дефолтах, но REST API будет закрыт, пока не задан ANTISPAM_API_KEYS.
# ============================================================

# --- доступ к REST API шлюза ---------------------------------
# Ключи через запятую; пусто = доступ закрыт (401 на всех /api/*)
ANTISPAM_API_KEYS=change-me-api-key
# Токен административных действий (выпуск из карантина, правка списков)
ANTISPAM_ADMIN_TOKEN=change-me-admin-token
# Общий секрет SMTP-фронта/милтера для эндпоинта /api/v1/gateway/mta-verify
ANTISPAM_MTA_TOKEN=change-me-mta-token

# --- прокси-ключи SOC-дашборда (frontend-контейнер) -----------
# Прокси Next.js подставляет их в запросы к бэкенду на сервере
GATEWAY_API_KEY=change-me-api-key
GATEWAY_ADMIN_TOKEN=change-me-admin-token

# --- ИИ-модуль GigaChat (необязательно) -----------------------
# Base64-ключ из личного кабинета Sber AI Studio (Basic-токен OAuth)
GIGACHAT_AUTH_KEY=
# Альтернатива GIGACHAT_AUTH_KEY: пара ключей
GIGACHAT_KEY_ADD=
GIGACHAT_KEY_SECRET=
# Модель и параметры вызова
ANTISPAM_GIGACHAT_MODEL=GigaChat-2-Max
# Без ключа шлюз честно работает в эвристическом режиме
# ANTISPAM_AI_ENABLED=false

# --- вход почты -----------------------------------------------
# watch  — разбор каталога-спула /app/data/spool (*.eml);
# smtp   — встроенный приёмный SMTP-сервер (:2525), 550 на отклоняемые;
# disabled — только REST API
ANTISPAM_MTA_MODE=watch
ANTISPAM_MTA_POLL_SECONDS=5
ANTISPAM_MTA_SMTP_HOST=0.0.0.0
ANTISPAM_MTA_SMTP_PORT=2525

# --- пороги решения и веса модулей (JSON) ---------------------
# ANTISPAM_THRESHOLDS={"warn":35,"hold":55,"quarantine":70,"block":85}
# ANTISPAM_MODULE_WEIGHTS={"heuristics":0.22,"urls":0.26,"auth":0.22,"attachments":0.12,"ai":0.18}

# --- внешние проверки ссылок ----------------------------------
# Для локальной разработки/тестов внешние вызовы можно выключить:
# ANTISPAM_RDAP_ENABLED=false
# ANTISPAM_DNS_CHECK_ENABLED=false
# ANTISPAM_FOLLOW_REDIRECTS=false

# --- прочее ---------------------------------------------------
ANTISPAM_LOG_LEVEL=INFO
# ANTISPAM_LOG_JSON=true          # логи в JSON для SIEM
# ANTISPAM_RATE_LIMIT_PER_IP=120  # запросов в минуту на IP
